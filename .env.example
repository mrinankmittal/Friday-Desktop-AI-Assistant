# Copy to `.env` and fill in values. Friday 1.0 still uses engine/config.py
# and engine/cookies.json; these variables are for Friday 2.0 providers.

FRIDAY_LLM_PROVIDER=ollama
FRIDAY_LLM_MODEL=gemma3:4b
OLLAMA_HOST=http://127.0.0.1:11434
# Default is local Ollama. Set huggingface_chat only if you want the cloud path.

# google (default, same as Friday 1.0) or faster_whisper (local, optional extra package)
FRIDAY_STT_PROVIDER=google
# English only. Use hi-IN,en-IN to listen in Hindi and English together.
FRIDAY_STT_LANGUAGE=en-IN

# sapi = English Windows voice (Zira). auto = also try Hindi voices when installed.
FRIDAY_TTS_PROVIDER=sapi
FRIDAY_TTS_NEURAL_HI=hi-IN-SwaraNeural
# Optional SAPI voice name fragments. Empty = auto (Hemant/Kalpana vs Zira).
FRIDAY_TTS_VOICE_HI=
FRIDAY_TTS_VOICE_EN=

# auto = openWakeWord when models/friday.onnx exists, else Google hotword
FRIDAY_WAKE_PROVIDER=auto
FRIDAY_WAKE_LANGUAGE=en-IN
FRIDAY_WAKE_THRESHOLD=0.5

FRIDAY_DATA_DIR=
# Optional workspace for code.read / code.patch / code.test. Empty = this repo.
FRIDAY_WORKSPACE=
# Semicolon-separated on Windows. Empty = Documents, Desktop, Downloads, Pictures, home, and this repo.
FRIDAY_ALLOW_PATHS=

# auto = Playwright when the package is installed (uses Edge/Chrome if present),
# otherwise the OS default browser (open only, no page text).
FRIDAY_BROWSER_PROVIDER=auto
FRIDAY_BROWSER_HEADLESS=false
FRIDAY_BROWSER_TIMEOUT_MS=20000

# auto = Windows OCR when winocr is installed; titles-only fallback otherwise
FRIDAY_VISION_PROVIDER=auto
FRIDAY_VISION_LANGUAGE=en

# High-risk email / Slack / Discord waits for yes / send it.
FRIDAY_REQUIRE_CONFIRM_SEND=true
# WhatsApp: false = send right after you dictate the message (faster).
# true = also ask "say send it". Unset follows FRIDAY_REQUIRE_CONFIRM_SEND.
FRIDAY_WHATSAPP_CONFIRM=false
# Seconds after opening WhatsApp before pressing Enter. Empty = auto (~0.7–1.4).
FRIDAY_WHATSAPP_LAUNCH_DELAY=0.8

# Gmail. Use your address plus an app password. Client ID is only for OAuth apps.
FRIDAY_USER_EMAIL=
FRIDAY_GMAIL_APP_PASSWORD=
FRIDAY_GOOGLE_CLIENT_ID=
FRIDAY_GOOGLE_CLIENT_SECRET=

# Slack OAuth app, or a bot token if the workspace already authorized Friday.
FRIDAY_SLACK_CLIENT_ID=
FRIDAY_SLACK_CLIENT_SECRET=
FRIDAY_SLACK_BOT_TOKEN=

# Discord OAuth app, or an incoming webhook URL.
FRIDAY_DISCORD_CLIENT_ID=
FRIDAY_DISCORD_CLIENT_SECRET=
FRIDAY_DISCORD_WEBHOOK_URL=

# Local loopback used after you allow access in the browser.
FRIDAY_OAUTH_REDIRECT=http://127.0.0.1:8765/oauth/callback
